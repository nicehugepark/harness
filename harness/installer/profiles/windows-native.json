{
  "dest": {
    "agents": ".claude/agents",
    "skills": ".claude/skills",
    "hooks": ".claude/hooks",
    "settings_fragments": "config/local/fragments"
  },
  "surfaces": {
    "user-settings": "../.claude/settings.json",
    "project-settings": ".claude/settings.json",
    "local-settings": ".claude/settings.local.json"
  },
  "backup_root": "~/harness-backups",
  "probe": {
    "mem": "wmic OS get FreePhysicalMemory",
    "cpu": "echo %NUMBER_OF_PROCESSORS%",
    "disk": "wmic logicaldisk get freespace",
    "notify": "powershell -NoProfile -Command"
  },
  "hook_invoke": "python {script}",
  "path_style": "windows",
  "unmeasured": "이 플랫폼의 훅 실행 셸·rename 원자성은 이 머신에서 잴 수 없다(E§9-M4·M9a) — 해당 플랫폼에서 재기록해야 한다",
  "platform": "windows-native"
}
